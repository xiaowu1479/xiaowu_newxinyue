# ============================================================
# 提交到 Git 仓库时的忽略规则
# 注意: .env 内含数据库账号密码,绝对不能提交
# ============================================================

# ---- 本地配置(严禁提交) ----
/.env
/.user.ini
# 注意: .sql_version 必须提交! make_manifest.php 会读它作为 SQL 版本号,
#       若被忽略,GitHub Action 生成的 manifest 里 sql_version 会变空,
#       导致站点永远检测不到数据库更新

# ---- 运行时与缓存 ----
/runtime/
/public/panchek/cache/
/.upgrade_tmp/

# ---- 站点数据与备份(不参与更新同步) ----
/public/uploads/
/backup/
/public/install/install.lock
/public/install/tmp/
/public/error.log
*.log

# ---- 本地临时/备份目录 ----
/网站备份/
/EHkRjZ_xinyue_source_backup/
/EHkRjZ_xinyue_source_backup.zip
/xinyue_source_2.0.0/
/xinyue.zip

# ---- 编辑器与系统文件 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# 说明: manifest.json 需要提交(站点更新时读取),因此不要忽略它
